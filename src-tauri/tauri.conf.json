{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CellPresenter",
  "version": "1.1.2",
  "identifier": "dev.cellpresenter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "CellPresenter contributors",
    "copyright": "© 2026 CellPresenter contributors. AGPL-3.0-or-later.",
    "category": "Utility",
    "shortDescription": "Free worship lyrics presenter",
    "longDescription": "Show song lyrics on a projector, TV or phones, run it from a phone, and give musicians chords in their own key. Works on your local network, no internet needed.",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEMDU3N0IxRUU3REVGNTkKUldSWjczM3VzWGNGYmNvUmJBSSt2Y09KMlNjeThGbzZCRTdXK1VocDJuZUxlSlZabW1ieXlCSVYK",
      "endpoints": [
        "https://github.com/thisisnich/cellpresenter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
